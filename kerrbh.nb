 FontSize->32]], "Subsection",
 CellChangeTimes->{{3.952024480863964*^9, 
  3.9520244873205853`*^9}},ExpressionUUID->"90d58a3e-9f49-498b-a007-\
64d9b3bd51fa"],

Cell[TextData[{
 "For a Kerr black hole in a uniform magnetic field ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> "B", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5512d45d-69eb-4d0e-90fa-cae25f59c316"],
 ", the potential ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["A", "TI"], "\[Mu]"], TraditionalForm], "errors" -> {}, 
     "input" -> "A_\\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c491672d-5e01-4cd1-a9e6-c6803326d3da"],
 " is given for the Wald solution:"
}], "Text",
 CellChangeTimes->{{3.9520244930946836`*^9, 
  3.952024514804634*^9}},ExpressionUUID->"91e7b3a4-980d-43bc-9bee-\
3b559c1f97a8"],

Cell[CellGroupData[{

Cell["Components:", "Subsubsection",
 CellChangeTimes->{
  3.952024543867929*^9},ExpressionUUID->"ab6b8309-c6de-4428-b213-\
265c826ef3f0"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["A", "TI"], 
         StyleBox["t", "TI"]], ":", 
        SubscriptBox[
         StyleBox["A", "TI"], 
         StyleBox["t", "TI"]], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}], "\[LongEqual]", 
        StyleBox["B", "TI"], 
        SubscriptBox[
         StyleBox["g", "TI"], 
         RowBox[{
           StyleBox["t", "TI"], "\[Phi]"}]], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}]}], TraditionalForm],
     "errors" -> {}, "input" -> 
    "A_t:\nA_t(r, \\theta) = B g_{t\\phi}(r, \\theta)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"76306a7a-9a9e-4eb9-9d6b-371cdbff2f32"]], \
"Item",
 CellChangeTimes->{{3.9520245667392*^9, 
  3.952024574436891*^9}},ExpressionUUID->"4c5ca171-0817-4f74-8d8e-\
47317f46aaf9"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["A", "TI"], "\[Phi]"], ":", 
        SubscriptBox[
         StyleBox["A", "TI"], "\[Phi]"], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}], "\[LongEqual]", 
        StyleBox["B", "TI"], 
        SubscriptBox[
         StyleBox["g", "TI"], "\[Phi]\[Phi]"], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}]}], TraditionalForm],
     "errors" -> {}, "input" -> 
    "A_\\phi:\nA_\\phi(r, \\theta) = B g_{\\phi\\phi}(r, \\theta)", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"84897769-c553-4098-9e1b-e108efd12f57"]], \
"Item",
 CellChangeTimes->{{3.9520245667392*^9, 
  3.952024584361768*^9}},ExpressionUUID->"d75aff6a-1574-45a5-9cfd-\
0cee3918a85b"],

Cell[TextData[{
 "These expressions for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "A_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e32684eb-641f-450b-953f-19e33f226869"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["A", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "A_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0517539-339b-448f-a775-cb8ebbdb9f56"],
 " involve the interaction between the magnetic field and the rotating \
spacetime geometry, incorporating the frame-dragging effects."
}], "Text",
 CellChangeTimes->{{3.952024595123728*^9, 
  3.952024612684752*^9}},ExpressionUUID->"642d2a43-95de-47c9-8342-\
ff396f744260"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AtWald", "[", 
    RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", 
   RowBox[{"B", " ", 
    RowBox[{"gCovTPhi", "[", 
     RowBox[{"r", ",", "\[Theta]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"APhiWald", "[", 
    RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", 
   RowBox[{"B", " ", 
    RowBox[{"gCovPhiPhi", "[", 
     RowBox[{"r", ",", "\[Theta]"}], "]"}]}]}], ";"}]}], "Code",
 CellChangeTimes->{
  3.952085026947057*^9, {3.952730818965974*^9, 3.952730819844201*^9}},
 CellLabel->
  "In[161]:=",ExpressionUUID->"d7587293-0607-494d-aaa9-b1d11ab98d30"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Effective Potential for Charged Particles",
 FontSize->32]], "Subsection",
 CellChangeTimes->{{3.952647817442471*^9, 
  3.9526478255028687`*^9}},ExpressionUUID->"a3c53113-e586-4a4c-a720-\
a7933949e567"],

Cell[TextData[{
 "Defining an effective potential, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "V_ {\\text {eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "75bafb00-372c-4fbb-a96e-cce35f078936"],
 " helps identify circular orbits and the energy of a charged particle . We \
combine the metric and electromagnetic potential into auxiliary functions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["coefA, coefB, coefC", TraditionalForm], 
     "errors" -> {}, "input" -> "\\text {coefA, coefB, coefC}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "271ce99e-a14c-4aa3-b141-2950f0727453"],
 " to solve for the energy ."
}], "Text",
 CellChangeTimes->{{3.952647864419022*^9, 3.952647869284463*^9}, {
  3.9527293515135107`*^9, 
  3.952729377980146*^9}},ExpressionUUID->"fec6bafa-0d87-4c68-ab20-\
c07712a91845"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coefA", "[", 
    RowBox[{"r_", ",", "\[Theta]_", ",", "Lz_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"gConTT", "[", 
     RowBox[{"r", ",", "\[Theta]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coefB", "[", 
    RowBox[{"r_", ",", "\[Theta]_", ",", "Lz_"}], "]"}], ":=", 
   RowBox[{"2", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"gConTPhi", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}], 
       RowBox[{"(", 
        RowBox[{"Lz", "-", 
         RowBox[{"APhiWald", "[", 
          RowBox[{"r", ",", "\[Theta]"}], "]"}]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"gConTT", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}], 
       RowBox[{"AtWald", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coefC", "[", 
    RowBox[{"r_", ",", "\[Theta]_", ",", "Lz_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"gConPhiPhi", "[", 
       RowBox[{"r", ",", "\[Theta]"}], "]"}]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Lz", "-", 
        RowBox[{"APhiWald", "[", 
         RowBox[{"r", ",", "\[Theta]"}], "]"}]}], ")"}], "2"]}], "-", 
    RowBox[{
     RowBox[{"gConTT", "[", 
      RowBox[{"r", ",", "\[Theta]"}], "]"}], 
     SuperscriptBox[
      RowBox[{"AtWald", "[", 
       RowBox[{"r", ",", "\[Theta]"}], "]"}], "2"]}], "+", 
    RowBox[{"2", 
     RowBox[{"gConTPhi", "[", 
      RowBox[{"r", ",", "\[Theta]"}], "]"}], 
     RowBox[{"AtWald", "[", 
      RowBox[{"r", ",", "\[Theta]"}], "]"}], 
     RowBox[{"(", 
      RowBox[{"Lz", "-", 
       RowBox[{"APhiWald", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}]}], ")"}]}], "-", "1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VeffCh", "[", 
    RowBox[{"r_", ",", "\[Theta]_", ",", "Lz_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"-", 
      RowBox[{"coefB", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "Lz"}], "]"}]}], "+", 
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"coefB", "[", 
         RowBox[{"r", ",", "\[Theta]", ",", "Lz"}], "]"}], "2"], "-", 
       RowBox[{"4", 
        RowBox[{"coefA", "[", 
         RowBox[{"r", ",", "\[Theta]", ",", "Lz"}], "]"}], 
        RowBox[{"coefC", "[", 
         RowBox[{"r", ",", "\[Theta]", ",", "Lz"}], "]"}]}]}]]}], 
    RowBox[{"2", 
     RowBox[{"coefA", "[", 
      RowBox[{"r", ",", "\[Theta]", ",", "Lz"}], "]"}]}]]}], ";"}]}], "Code",
 CellChangeTimes->{{3.952647914765023*^9, 3.9526480188151283`*^9}, {
  3.952648132397562*^9, 3.9526482098748693`*^9}, {3.9526498264246883`*^9, 
  3.952649844886318*^9}, {3.952727478964676*^9, 3.952727482420969*^9}, {
  3.952727516938862*^9, 3.952727535319751*^9}, {3.952730563676156*^9, 
  3.952730625199925*^9}},
 CellLabel->
  "In[163]:=",ExpressionUUID->"1cbb951f-68d4-4f8f-9836-23b7b20489dc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["ISCO, SPECIFIC E & L FOR KERR ",
 FontSize->32]], "Subsection",
 CellChangeTimes->{{3.952647817442471*^9, 3.9526478255028687`*^9}, 
   3.9526482414919786`*^9},ExpressionUUID->"53868a4d-7b99-4e2a-925f-\
32fe0a6cd910"],

Cell["", "Text",
 CellChangeTimes->{{3.952647864419022*^9, 3.952647869284463*^9}, 
   3.9527294228635187`*^9},ExpressionUUID->"258ba7d7-5bcb-4680-95b1-\
8262eeb110fa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kerrEE", "[", 
    RowBox[{"r_", ",", "s_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"1", "-", 
     RowBox[{"2", "/", "r"}], "+", 
     RowBox[{"s", "/", 
      SuperscriptBox["r", 
       RowBox[{"3", "/", "2"}]]}]}], 
    SqrtBox[
     RowBox[{"1", "-", 
      RowBox[{"3", "/", "r"}], "+", 
      RowBox[{"2", 
       RowBox[{"s", "/", 
        SuperscriptBox["r", 
         RowBox[{"3", "/", "2"}]]}]}]}]]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kerrLL", "[", 
     RowBox[{"r_", ",", "s_"}], "]"}], ":=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["r", 
       RowBox[{"1", "/", "2"}]], "-", 
      RowBox[{"2", 
       RowBox[{"s", "/", "r"}]}], "+", 
      RowBox[{
       SuperscriptBox["s", "2"], "/", 
       SuperscriptBox["r", 
        RowBox[{"3", "/", "2"}]]}]}], 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{"3", "/", "r"}], "+", 
       RowBox[{"2", 
        RowBox[{"s", "/", 
         SuperscriptBox["r", 
          RowBox[{"3", "/", "2"}]]}]}]}]]]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Z1Kerr", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"1", "+", 
    RowBox[{
     RadicalBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["s", "2"]}], ")"}], "3"], 
     RowBox[{"(", 
      RowBox[{
       RadicalBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "s"}], ")"}], "3"], "+", 
       RadicalBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "s"}], ")"}], "3"]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Z2Kerr", "[", "s_", "]"}], ":=", 
    SqrtBox[
     RowBox[{
      RowBox[{"3", 
       SuperscriptBox["s", "2"]}], "+", 
      SuperscriptBox[
       RowBox[{"Z1Kerr", "[", "s", "]"}], "2"]}]]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rISCOm", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"3", " ", "+", " ", 
    RowBox[{"Z2Kerr", "[", "s", "]"}], " ", "-", " ", 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", " ", "-", " ", 
        RowBox[{"Z1Kerr", "[", "s", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"3", " ", "+", " ", 
        RowBox[{"Z1Kerr", "[", "s", "]"}], " ", "+", " ", 
        RowBox[{"2", " ", 
         RowBox[{"Z2Kerr", "[", "s", "]"}]}]}], ")"}]}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rISCOp", "[", "s_", "]"}], " ", ":=", "  ", 
    RowBox[{"3", " ", "+", " ", 
     RowBox[{"Z2Kerr", "[", "s", "]"}], " ", "+", " ", 
     SqrtBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", " ", "-", " ", 
         RowBox[{"Z1Kerr", "[", "s", "]"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"3", " ", "+", " ", 
         RowBox[{"Z1Kerr", "[", "s", "]"}], " ", "+", " ", 
         RowBox[{"2", " ", 
          RowBox[{"Z2Kerr", "[", "s", "]"}]}]}], ")"}]}]]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
