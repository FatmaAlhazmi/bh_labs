Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveTrajectory", "[", 
    RowBox[{"rinit_", ",", "\[Theta]init_", ",", "Lz_", ",", "xEND_"}], "]"}],
    ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{
      "r", ",", "pr", ",", "\[Theta]", ",", " ", "p\[Theta]", ",", "\[Phi]"}],
       "]"}], ";", "\n", "\[IndentingNewLine]", 
     RowBox[{"EE", "=", 
      RowBox[{"VeffCh", "[", 
       RowBox[{"rinit", ",", "\[Theta]init", ",", "Lz"}], "]"}]}], ";", "\n", 
     
     RowBox[{"Print", "[", 
      RowBox[{"\"\<a=\>\"", ",", "a", ",", "\"\<  B=\>\"", ",", "B", 
       ",", "\"\<  Lz=\>\"", ",", "Lz", ",", "\"\<  E=\>\"", ",", "EE"}], 
      "]"}], ";", "\n", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Hgeo", "[", 
       RowBox[{"r_", ",", "\[Theta]_", ",", "pr_", ",", "p\[Theta]_"}], "]"}],
       ":=", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"gConRR", "[", 
         RowBox[{"r", ",", "\[Theta]"}], "]"}], 
        SuperscriptBox["pr", "2"]}], "+", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"gConThTh", "[", 
         RowBox[{"r", ",", "\[Theta]"}], "]"}], 
        SuperscriptBox["p\[Theta]", "2"]}], "+", 
       FractionBox["1", "2"], "+", "\n", "    ", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"gConTT", "[", 
            RowBox[{"r", ",", "\[Theta]"}], "]"}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "EE"}], "-", 
              RowBox[{"AtWald", "[", 
               RowBox[{"r", ",", "\[Theta]"}], "]"}]}], ")"}], "2"]}], "+", 
          RowBox[{"2", 
           RowBox[{"gConTPhi", "[", 
            RowBox[{"r", ",", "\[Theta]"}], "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "EE"}], "-", 
             RowBox[{"AtWald", "[", 
              RowBox[{"r", ",", "\[Theta]"}], "]"}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{"Lz", "-", 
             RowBox[{"APhiWald", "[", 
              RowBox[{"r", ",", "\[Theta]"}], "]"}]}], ")"}]}], "+", 
          RowBox[{
           RowBox[{"gConPhiPhi", "[", 
            RowBox[{"r", ",", "\[Theta]"}], "]"}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"Lz", "-", 
              RowBox[{"APhiWald", "[", 
               RowBox[{"r", ",", "\[Theta]"}], "]"}]}], ")"}], "2"]}]}], 
         ")"}]}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"DrHgeo", "[", 
       RowBox[{"r_", ",", "\[Theta]_", ",", "pr_", ",", "p\[Theta]_"}], "]"}],
       ":=", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Hgeo", "[", 
         RowBox[{"r", ",", "\[Theta]", ",", "pr", ",", "p\[Theta]"}], "]"}], ",",
         "r"}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"D\[Theta]Hgeo", "[", 
       RowBox[{"r_", ",", "\[Theta]_", ",", "pr_", ",", "p\[Theta]_"}], "]"}],
       ":=", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Hgeo", "[", 
         RowBox[{"r", ",", "\[Theta]", ",", "pr", ",", "p\[Theta]"}], "]"}], ",",
         "\[Theta]"}], "]"}]}], ";", "\n", 
     RowBox[{"HInvariant", "=", 
      RowBox[{"Hgeo", "[", 
       RowBox[{
        RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
        RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
        RowBox[{"pr", "[", "\[Tau]", "]"}], ",", 
        RowBox[{"p\[Theta]", "[", "\[Tau]", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"eom", " ", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"r", "'"}], "[", "\[Tau]", "]"}], "   ", "\[Equal]", "    ", 
         RowBox[{
          RowBox[{"gConRR", "[", 
           RowBox[{
            RowBox[{"r", "[", "\[Tau]", "]"}], " ", ",", 
            RowBox[{"\[Theta]", "[", "\[Tau]", "]"}]}], "]"}], 
          RowBox[{"pr", "[", "\[Tau]", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"pr", "'"}], "[", "\[Tau]", "]"}], "  ", "==", " ", 
         RowBox[{"-", 
          RowBox[{"DrHgeo", "[", 
           RowBox[{
            RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
            RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
            RowBox[{"pr", "[", "\[Tau]", "]"}], ",", 
            RowBox[{"p\[Theta]", "[", "\[Tau]", "]"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Theta]", "'"}], "[", "\[Tau]", "]"}], "   ", "\[Equal]", 
         "   ", 
         RowBox[{
          RowBox[{"gConThTh", "[", 
           RowBox[{
            RowBox[{"r", "[", "\[Tau]", "]"}], " ", ",", 
            RowBox[{"\[Theta]", "[", "\[Tau]", "]"}]}], " ", "]"}], 
          RowBox[{"p\[Theta]", "[", "\[Tau]", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"p\[Theta]", "'"}], "[", "\[Tau]", "]"}], "  ", "\[Equal]", 
         
         RowBox[{"-", 
          RowBox[{"D\[Theta]Hgeo", "[", 
           RowBox[{
            RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
            RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
            RowBox[{"pr", "[", "\[Tau]", "]"}], ",", 
            RowBox[{"p\[Theta]", "[", "\[Tau]", "]"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Phi]", "'"}], "[", "\[Tau]", "]"}], "   ", "\[Equal]", 
         "   ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"gConTPhi", "[", 
             RowBox[{
              RowBox[{"r", "[", "\[Tau]", "]"}], " ", ",", 
              RowBox[{"\[Theta]", "[", "\[Tau]", "]"}]}], "]"}]}], "EE"}], "+",
           " ", 
          RowBox[{
           RowBox[{"gConPhiPhi", "[", 
            RowBox[{
             RowBox[{"r", "[", "\[Tau]", "]"}], " ", ",", 
             RowBox[{"\[Theta]", "[", "\[Tau]", "]"}]}], "]"}], "Lz"}], "-", 
          RowBox[{
           RowBox[{"gConTPhi", "[", 
            RowBox[{
             RowBox[{"r", "[", "\[Tau]", "]"}], " ", ",", 
             RowBox[{"\[Theta]", "[", "\[Tau]", "]"}]}], "]"}], 
           RowBox[{"AtWald", "[", 
            RowBox[{
             RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
             RowBox[{"\[Theta]", "[", "\[Tau]", "]"}]}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"gConPhiPhi", "[", 
            RowBox[{
             RowBox[{"r", "[", "\[Tau]", "]"}], " ", ",", 
             RowBox[{"\[Theta]", "[", "\[Tau]", "]"}]}], "]"}], 
           RowBox[{"APhiWald", "[", 
            RowBox[{
             RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
             RowBox[{"\[Theta]", "[", "\[Tau]", "]"}]}], "]"}]}]}]}]}], "  ", 
       "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ics", " ", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "0", "]"}], "\[Equal]", "rinit"}], ",", " ", 
        RowBox[{
         RowBox[{"pr", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{"\[Theta]", "[", "0", "]"}], "\[Equal]", "\[Theta]init"}], ",",
         " ", 
        RowBox[{
         RowBox[{"p\[Theta]", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"step0", "=", 
      SuperscriptBox["10", 
       RowBox[{"-", "4"}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", 
      RowBox[{"numMethod", ",", "\[IndentingNewLine]", "1", ",", "\n", 
       RowBox[{
        RowBox[{"methodChoice", "=", 
         RowBox[{"{", 
          RowBox[{"\"\<StiffnessSwitching\>\"", ",", " ", "\n", 
           RowBox[{"Method", "\[Rule]", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<Projection\>\"", ",", " ", 
                RowBox[{"Method", "\[Rule]", 
                 RowBox[{"{", 
                  RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
                   RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "9"}]}], 
                  "}"}]}], ",", 
                RowBox[{"\"\<Invariants\>\"", "\[Rule]", "HInvariant"}]}], 
               "}"}], ",", "Automatic"}], "}"}]}]}], "}"}]}], ";"}], ",", 
       "\[IndentingNewLine]", "2", ",", 
       RowBox[{
        RowBox[{"step0", "=", 
         SuperscriptBox["10", 
          RowBox[{"-", "4"}]]}], ";", 
        RowBox[{"methodChoice", "=", 
         RowBox[{"{", 
          RowBox[{"\"\<FixedStep\>\"", ",", 
           RowBox[{"Method", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
              RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "4"}]}], 
             "}"}]}]}], "}"}]}], ";"}], ",", "\[IndentingNewLine]", "_", ",", 
       
       RowBox[{"methodChoice", "=", "Automatic"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"solTraj", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eom", ",", "ics"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "r", ",", "pr", ",", "\[Theta]", ",", "p\[Theta]", ",", "\[Phi]"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Tau]", ",", "0", ",", " ", "xEND"}], "}"}], ",", "\n", 
        "  ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Method", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"\"\<EventLocator\>\"", ",", 
             RowBox[{"\"\<Event\>\"", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"r", "[", "\[Tau]", "]"}], "-", "rStopH"}], ",", 
                RowBox[{
                 RowBox[{"r", "[", "\[Tau]", "]"}], "-", "rStopInf"}]}], 
               "}"}]}], ",", "\n", "     ", 
             RowBox[{"\"\<EventAction\>\"", "\[RuleDelayed]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Throw", "[", " ", 
                 RowBox[{"Null", ",", "\"\<StopIntegration\>\""}], "]"}], ",", 
                RowBox[{"Throw", "[", 
                 RowBox[{"Null", ",", " ", "\"\<StopIntegration\>\""}], 
                 "]"}]}], "}"}]}], ",", 
             RowBox[{"\"\<Method\>\"", "\[Rule]", "methodChoice"}]}], "}"}]}],
           ",", "\n", "   ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"StartingStepSize", "\[Rule]", "step0"}], ",", 
            RowBox[{"MaxSteps", "\[Rule]", "\[Infinity]"}]}], "}"}]}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ipub", "=", " ", 
      RowBox[{"r", "/.", 
       RowBox[{"solTraj", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], ";", 
     RowBox[{"tauDomain", "=", 
      RowBox[{"ipub", "[", "\"\<Domain\>\"", "]"}]}], ";", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tau0", ",", "tau1"}], "}"}], " ", "=", " ", 
      RowBox[{"tauDomain", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<tau0=\>\"", ",", "tau0", ",", "\"\<  tau1=\>\"", ",", 
       "tau1"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", ")"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.952647914765023*^9, 3.9526480188151283`*^9}, 
   3.952725833036714*^9, {3.9527258937212048`*^9, 3.952725927625642*^9}, {
   3.952725978300696*^9, 3.952726000702196*^9}, {3.95272603427227*^9, 
   3.952726156243182*^9}, {3.952726197622094*^9, 3.952726199174602*^9}, 
   3.952728069286326*^9, {3.952728120608*^9, 3.952728142541338*^9}, {
   3.9527283614633904`*^9, 3.9527283710022*^9}, {3.952728402076317*^9, 
   3.952728405516994*^9}, {3.952728485323431*^9, 3.952728557386787*^9}, {
   3.952729655550078*^9, 3.952729663889868*^9}, {3.952730938671064*^9, 
   3.952730955836542*^9}, 3.952731028585669*^9},
 CellLabel->
  "In[182]:=",ExpressionUUID->"fdbe172b-86ed-4d69-92e5-3a412a07f99a"]
