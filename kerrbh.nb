Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SuperscriptBox[
         StyleBox["g", "TI"], "\[Phi]\[Phi]"], ":", 
        SuperscriptBox[
         StyleBox["g", "TI"], "\[Phi]\[Phi]"], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}], "\[LongEqual]", 
        FractionBox[
         RowBox[{"\[CapitalDelta]", 
           RowBox[{"(", 
             StyleBox["r", "TI"], ")"}], "-", 
           SuperscriptBox[
            StyleBox["a", "TI"], "2"], 
           SuperscriptBox["sin", "2"], 
           RowBox[{"(", "\[Theta]", ")"}]}], 
         RowBox[{"\[CapitalDelta]", 
           RowBox[{"(", 
             StyleBox["r", "TI"], ")"}], 
           SuperscriptBox[
            StyleBox["R", "TI"], "2"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}], 
           SuperscriptBox["sin", "2"], 
           RowBox[{"(", "\[Theta]", ")"}]}]]}], TraditionalForm], 
    "errors" -> {}, "input" -> 
    "g^{\\phi\\phi}:\ng^{\\phi\\phi}(r, \\theta) = \\frac{\\Delta(r) - a^2 \
\\sin^2(\\theta)}{\\Delta(r) R^2(r, \\theta) \\sin^2(\\theta)}", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"2bb399fb-3715-4187-8347-9630dd555c3f"]], \
"Item",
 CellChangeTimes->{{3.952024342090838*^9, 
  3.9520243672337837`*^9}},ExpressionUUID->"78bcc622-51f1-4c61-9b68-\
c2148ca9c722"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SuperscriptBox[
         StyleBox["g", "TI"], 
         RowBox[{
           StyleBox["r", "TI"], 
           StyleBox["r", "TI"]}]], ":", 
        SuperscriptBox[
         StyleBox["g", "TI"], 
         RowBox[{
           StyleBox["r", "TI"], 
           StyleBox["r", "TI"]}]], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}], "\[LongEqual]", 
        FractionBox[
         RowBox[{"\[CapitalDelta]", "(", 
           StyleBox["r", "TI"], ")"}], 
         RowBox[{
           SuperscriptBox[
            StyleBox["R", "TI"], "2"], "(", 
           RowBox[{
             StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}]]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "g^{rr}:\ng^{rr}(r, \\theta) = \\frac{\\Delta(r)}{R^2(r, \\theta)}", 
    "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"23e265a5-fc44-4399-a65c-1d0b79d1b237"]], \
"Item",
 CellChangeTimes->{{3.952024342090838*^9, 
  3.9520243846484327`*^9}},ExpressionUUID->"ce15c4d8-c99b-44fc-a7d6-\
2346713ba5eb"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SuperscriptBox[
         StyleBox["g", "TI"], "\[Theta]\[Theta]"], ":", 
        SuperscriptBox[
         StyleBox["g", "TI"], "\[Theta]\[Theta]"], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}], "\[LongEqual]", 
        FractionBox["1", 
         RowBox[{
           SuperscriptBox[
            StyleBox["R", "TI"], "2"], "(", 
           RowBox[{
             StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}]]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "g^{\\theta\\theta}:\ng^{\\theta\\theta}(r, \\theta) = \\frac{1}{R^2(r, \
\\theta)}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"b33a81bd-9e2f-4161-8e12-91211c2b341a"]], \
"Item",
 CellChangeTimes->{{3.952024342090838*^9, 
  3.9520243862016773`*^9}},ExpressionUUID->"03fb119e-5a40-4f2c-b704-\
134518a09a9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gConTT", "[", 
    RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"DeltaK", "[", 
       RowBox[{"r", ",", "\[Theta]"}], "]"}]]}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["r", "2"], "+", 
      SuperscriptBox["a", "2"], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "  ", "M", " ", "r", " ", 
         SuperscriptBox["a", "2"], " "}], 
        RowBox[{" ", 
         RowBox[{"SigmaK", "[", 
          RowBox[{"r", ",", "\[Theta]"}], "]"}]}]], 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gConTPhi", "[", 
     RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"2", " ", "M", " ", "a", " ", "r"}], 
      RowBox[{
       RowBox[{"DeltaK", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}], " ", 
       RowBox[{"SigmaK", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}]}]]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gConPhiPhi", "[", 
    RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"DeltaK", "[", 
      RowBox[{"r", ",", "\[Theta]"}], "]"}], "-", " ", 
     RowBox[{
      SuperscriptBox["a", "2"], 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], 
    RowBox[{
     RowBox[{"DeltaK", "[", 
      RowBox[{"r", ",", "\[Theta]"}], "]"}], 
     RowBox[{"SigmaK", "[", 
      RowBox[{"r", ",", "\[Theta]"}], "]"}], 
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gConRR", "[", 
    RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"DeltaK", "[", 
     RowBox[{"r", ",", "\[Theta]"}], "]"}], 
    RowBox[{"SigmaK", "[", 
     RowBox[{"r", ",", "\[Theta]"}], "]"}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gConThTh", "[", 
    RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", 
   FractionBox["1", 
    RowBox[{"SigmaK", "[", 
     RowBox[{"r", ",", "\[Theta]"}], "]"}]]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9520849435783043`*^9, 3.952085011065731*^9}, {
   3.952645500844499*^9, 3.952645521161251*^9}, {3.952727094763715*^9, 
   3.952727132110586*^9}, 3.952727187479604*^9},
 CellLabel->
  "In[156]:=",ExpressionUUID->"8530c2ef-f23e-489f-a549-c6dc3498231d"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

