Cell[BoxData[{
 RowBox[{
  RowBox[{"fonty", "=", "15"}], ";", 
  RowBox[{"fontyW", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FontSize", "\[Rule]", "15"}], ",", 
     RowBox[{"Background", "\[Rule]", "White"}]}], "}"}]}], ";", 
  RowBox[{"ImSz", "=", "250"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"range1D", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "10.5"}], ",", "10.5"}], "}"}]}], ";", 
   RowBox[{"range2D", "=", 
    RowBox[{"{", 
     RowBox[{"range1D", ",", "range1D"}], "}"}]}], ";", 
   RowBox[{"range3D", "=", 
    RowBox[{"{", 
     RowBox[{"range1D", ",", "range1D", ",", "range1D"}], "}"}]}], ";"}], 
