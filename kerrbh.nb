                    RowBox[{"0.5", ",", "0.1"}], "}"}], "]"}]}], "]"}], ",", 
                "\n", "    ", 
                RowBox[{"Text", "[", 
                 RowBox[{
                  RowBox[{"Row", "[", 
                   RowBox[{"{", 
                    RowBox[{"\"\<E\[DotEqual]\>\"", ",", 
                    RowBox[{"Round", "[", 
                    RowBox[{"EE", ",", "0.01"}], "]"}], 
                    ",", "\"\< | L\[DotEqual]\>\"", ",", 
                    RowBox[{"Round", "[", 
                    RowBox[{"Lz", ",", "0.01"}], "]"}]}], "}"}], "]"}], ",", 
                  RowBox[{"Scaled", "[", 
                   RowBox[{"{", 
                    RowBox[{"0.5", ",", "0.9"}], "}"}], "]"}]}], "]"}]}], 
               "\[IndentingNewLine]", "}"}]}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"pic3", "=", 
           RowBox[{"Show", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"ContourPlot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"VeffCh", "[", 
                 RowBox[{
                  SqrtBox[
                   RowBox[{
                    SuperscriptBox["xx", "2"], "+", 
                    SuperscriptBox["zz", "2"]}]], ",", 
                  RowBox[{"ArcTan", "[", 
                   RowBox[{"zz", ",", "xx"}], "]"}], ",", "Lz"}], "]"}], "\[Equal]",
                 "EE"}], ",", 
               RowBox[{"{", 
                RowBox[{"xx", ",", "0", ",", 
                 RowBox[{"range1D", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"zz", ",", 
                 RowBox[{
                  RowBox[{"range1D", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "/", "2"}], ",", 
                 RowBox[{
                  RowBox[{"range1D", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "/", "2"}]}], "}"}], ",", 
               "\n", "  ", 
               RowBox[{"ContourStyle", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{"{", 
                  RowBox[{"Red", ",", "Thick", ",", "Dotted"}], "}"}], 
                 "}"}]}], ",", 
               RowBox[{"Frame", "\[Rule]", "True"}], ",", 
               RowBox[{"BaseStyle", "\[Rule]", "fontyW"}], ",", 
               RowBox[{"FrameLabel", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{"\"\<x\>\"", ",", "\"\<z\>\""}], "}"}]}], ",", 
               RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\n", "  ", 
               RowBox[{"Frame", "\[Rule]", "True"}], ",", 
               RowBox[{"RotateLabel", "\[Rule]", "False"}], ",", 
               RowBox[{"Axes", "\[Rule]", "False"}], ",", 
               RowBox[{"ImageSize", "\[Rule]", "ImSz"}], ",", "\n", "  ", 
               RowBox[{"Epilog", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{"LightGray", ",", 
                  RowBox[{"Disk", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "0"}], "}"}], ",", "rH"}], "]"}], ",", 
                  "Black", ",", 
                  RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
                  RowBox[{"Point", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"xCart", "[", 
                    RowBox[{"rinit", ",", "\[Theta]init", ",", "\[Phi]init"}],
                     "]"}], ",", 
                    RowBox[{"zCart", "[", 
                    RowBox[{"rinit", ",", "\[Theta]init", ",", "\[Phi]init"}],
                     "]"}]}], "}"}], "]"}]}], "}"}]}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"ParametricPlot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"xCart", "[", 
                   RowBox[{
                    RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
                    RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", "0"}], 
                   "]"}], ",", 
                  RowBox[{"zCart", "[", 
                   RowBox[{
                    RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
                    RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", "0"}], 
                   "]"}]}], " ", "}"}], "/.", "solTraj"}], ",", 
               RowBox[{"{", 
                RowBox[{"\[Tau]", ",", "tau0", ",", "tau1"}], "}"}], ",", 
               RowBox[{"PlotStyle", "\[Rule]", 
                RowBox[{"{", "colour", "}"}]}]}], "]"}]}], 
            "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"pic4", "=", 
           RowBox[{"Show", "[", 
            RowBox[{
             RowBox[{"ParametricPlot3D", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", " ", 
                 RowBox[{
                  RowBox[{"xCart", "[", 
                   RowBox[{
                    RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
                    RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
                    RowBox[{"\[Phi]", "[", "\[Tau]", "]"}]}], "]"}], ",", " ", 
                  RowBox[{"yCart", "[", 
                   RowBox[{
                    RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
                    RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
                    RowBox[{"\[Phi]", "[", "\[Tau]", "]"}]}], "]"}], ",", 
                  "  ", 
                  RowBox[{"zCart", "[", 
                   RowBox[{
                    RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
                    RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
                    RowBox[{"\[Phi]", "[", "\[Tau]", "]"}]}], "]"}]}], " ", 
                 "}"}], "/.", "solTraj"}], ",", "\n", "    ", 
               RowBox[{"{", 
                RowBox[{"\[Tau]", ",", "tau0", ",", "tau1"}], "}"}], ",", 
               RowBox[{"PlotRange", "\[Rule]", "range3D"}], ",", 
               RowBox[{"BoxStyle", "\[Rule]", 
                RowBox[{"{", "Black", "}"}]}], ",", 
               RowBox[{"PlotStyle", "\[Rule]", 
                RowBox[{"{", "colour", "}"}]}], ",", 
               RowBox[{"ViewPoint", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"-", "3"}], ",", "1"}], "}"}]}], ",", "\n", "    ", 
               
               RowBox[{"Ticks", "\[Rule]", "None"}], ",", 
               RowBox[{"ImageSize", "\[Rule]", "ImSz"}]}], "]"}], ",", 
             "\[IndentingNewLine]", "  ", 
             RowBox[{"Graphics3D", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"Black", ",", 
                  RowBox[{"Text", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"paramLabel", ",", "fontyW"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", 
                    RowBox[{"0.5", 
                    RowBox[{"range1D", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                    RowBox[{"1", 
                    RowBox[{"range1D", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}]}], "]"}]}], 
                 "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"LightGray", ",", 
                  RowBox[{"Sphere", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "rH"}], 
                   "]"}]}], "}"}], ",", "\n", "     ", 
                RowBox[{"{", 
                 RowBox[{"Black", ",", 
                  RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
                  RowBox[{"Point", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"xCart", "[", 
                    RowBox[{"rinit", ",", "\[Theta]init", ",", "\[Phi]init"}],
                     "]"}], ",", 
                    RowBox[{"yCart", "[", 
                    RowBox[{"rinit", ",", "\[Theta]init", ",", "\[Phi]init"}],
                     "]"}], ",", 
                    RowBox[{"zCart", "[", 
                    RowBox[{"rinit", ",", "\[Theta]init", ",", "\[Phi]init"}],
                     "]"}]}], "}"}], "]"}]}], "}"}]}], "}"}], "]"}], ",", 
             RowBox[{"Lighting", "\[Rule]", "\"\<Neutral\>\""}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "}"}], "}"}], ",", 
       RowBox[{"Spacings", "->", "0"}], ",", 
       RowBox[{"ImageSize", "->", "1000"}]}], "]"}]}], "\[IndentingNewLine]", 
    ")"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.952647914765023*^9, 3.9526480188151283`*^9}, 
   3.9527262459665203`*^9, {3.952726319084949*^9, 3.952726509092778*^9}, {
   3.952726543315744*^9, 3.952726636791506*^9}, {3.952726669721785*^9, 
   3.952726721876395*^9}, {3.952726755918408*^9, 3.952726813470501*^9}, {
   3.9527268563903008`*^9, 3.952726876889523*^9}, {3.952728580288609*^9, 
   3.9527285848436327`*^9}, {3.952728623227417*^9, 3.952728689691627*^9}, {
   3.952728751409527*^9, 3.9527287720862703`*^9}, {3.95272880552217*^9, 
   3.952728812380444*^9}, {3.952728906274046*^9, 3.9527289453577213`*^9}, {
   3.952729527157461*^9, 3.9527295330978518`*^9}, 3.952731017783284*^9},
