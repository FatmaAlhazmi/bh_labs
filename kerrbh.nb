Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotTrajectory", "[", "colour_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Phi]init", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsGrid", "[", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pic1", "=", 
           RowBox[{"ParametricPlot", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"xCart", "[", 
                 RowBox[{
                  RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
                  RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
                  RowBox[{"\[Phi]", "[", "\[Tau]", "]"}]}], "]"}], ",", " ", 
                RowBox[{"yCart", "[", 
                 RowBox[{
                  RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
                  RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
                  RowBox[{"\[Phi]", "[", "\[Tau]", "]"}]}], "]"}]}], " ", 
               "}"}], "/.", "solTraj"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Tau]", ",", "tau0", ",", "tau1"}], "}"}], ",", 
             RowBox[{"PlotStyle", "\[Rule]", 
              RowBox[{"{", "colour", "}"}]}], ",", "\n", "     ", 
             RowBox[{"Frame", "\[Rule]", "True"}], ",", 
             RowBox[{"BaseStyle", "\[Rule]", "fontyW"}], ",", 
             RowBox[{"PlotRange", "\[Rule]", "range2D"}], ",", 
             RowBox[{"Prolog", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"LightGray", ",", 
                RowBox[{"Disk", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0"}], "}"}], ",", "rH"}], "]"}]}], 
               "}"}]}], ",", "\[IndentingNewLine]", "     ", 
             RowBox[{"Epilog", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
                RowBox[{"Point", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"xCart", "[", 
                    RowBox[{"rinit", ",", "\[Theta]init", ",", "\[Phi]init"}],
                     "]"}], ",", 
                   RowBox[{"yCart", "[", 
                    RowBox[{"rinit", ",", "\[Theta]init", ",", "\[Phi]init"}],
                     "]"}]}], "}"}], "]"}]}], "}"}]}], ",", 
             RowBox[{"FrameLabel", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
             RowBox[{"RotateLabel", "\[Rule]", "False"}], ",", "\n", "     ", 
             
             RowBox[{"Axes", "\[Rule]", "False"}], ",", 
             RowBox[{"ImageSize", "\[Rule]", "ImSz"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"pic2", "=", 
           RowBox[{"ParametricPlot", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"xCart", "[", 
                 RowBox[{
                  RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
                  RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
                  RowBox[{"\[Phi]", "[", "\[Tau]", "]"}]}], "]"}], ",", 
                RowBox[{"zCart", "[", 
                 RowBox[{
                  RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
                  RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
