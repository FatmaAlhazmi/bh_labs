 RowBox[{
  RowBox[{
   RowBox[{"SigmaK", "[", 
    RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", " ", 
   RowBox[{
    SuperscriptBox["r", "2"], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["a", "2"], " ", 
