               "}"}], "/.", "solTraj"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Tau]", ",", "tau0", ",", "tau1"}], "}"}], ",", 
             RowBox[{"PlotStyle", "\[Rule]", 
              RowBox[{"{", "colour", "}"}]}], ",", "\n", "  ", 
             RowBox[{"Frame", "\[Rule]", "True"}], ",", 
             RowBox[{"BaseStyle", "\[Rule]", "fontyW"}], ",", 
             RowBox[{"PlotRange", "\[Rule]", "range2D"}], ",", 
             RowBox[{"Prolog", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"LightGray", ",", 
                RowBox[{"Disk", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0"}], "}"}], ",", "rH"}], "]"}]}], 
               "}"}]}], ",", "\n", "  ", 
             RowBox[{"FrameLabel", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"\"\<x\>\"", ",", "\"\<z\>\""}], "}"}]}], ",", 
             RowBox[{"RotateLabel", "\[Rule]", "False"}], ",", 
             RowBox[{"Axes", "\[Rule]", "False"}], ",", 
             RowBox[{"ImageSize", "\[Rule]", "ImSz"}], ",", 
             "\[IndentingNewLine]", " ", 
             RowBox[{"Epilog", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
                RowBox[{"Point", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"xCart", "[", 
                    RowBox[{"rinit", ",", "\[Theta]init", ",", "\[Phi]init"}],
                     "]"}], ",", 
                   RowBox[{"zCart", "[", 
                    RowBox[{"rinit", ",", "\[Theta]init", ",", "\[Phi]init"}],
                     "]"}]}], "}"}], "]"}], ",", "\n", "    ", 
                RowBox[{"Text", "[", 
                 RowBox[{
                  RowBox[{"Row", "[", 
                   RowBox[{"{", 
                    
                    RowBox[{"\"\<\!\(\*SubscriptBox[\(r\), \
\(0\)]\)\[DotEqual]\>\"", ",", 
                    RowBox[{"Round", "[", 
                    RowBox[{"rinit", ",", "0.01"}], "]"}], 
                    ",", "\"\<| \!\(\*SubscriptBox[\(\[Theta]\), \(0\)]\)\
\[DotEqual]\>\"", ",", 
                    RowBox[{"Round", "[", 
                    RowBox[{"\[Theta]init", ",", "0.01"}], "]"}]}], "}"}], 
                   "]"}], ",", 
                  RowBox[{"Scaled", "[", 
