       RowBox[{"{", 
        RowBox[{"be", ",", " ", "dim"}], "}"}]}], "\n", "]"}]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chr", "[", 
     RowBox[{"mu_", ",", " ", "al_", ",", " ", "be_"}], "]"}], " ", ":=", " ", 
    RowBox[{"chrTab", "[", 
     RowBox[{"[", 
      RowBox[{"mu", ",", " ", "al", ",", " ", "be"}], "]"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chrList", " ", ":=", " ", 
    RowBox[{"Select", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"mu", ",", " ", "al", ",", " ", "be", ",", " ", 
            RowBox[{"chrTab", "[", 
             RowBox[{"[", 
              RowBox[{"mu", ",", " ", "al", ",", " ", "be"}], "]"}], "]"}]}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"mu", ",", " ", "dim"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"al", ",", " ", "dim"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"be", ",", " ", "dim"}], "}"}]}], "]"}], ",", " ", "2"}], 
       "]"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "4", "]"}], "]"}], " ", "=!=", " ", "0"}], " ", "&"}]}],
      "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"showChr", "[", "]"}], " ", ":=", " ", 
    RowBox[{"Grid", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Prepend", "[", "\n", "     ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", "\n", "         ", 
             RowBox[{"\"\<Gamma^\>\"", ",", " ", 
              RowBox[{"lab", "[", 
               RowBox[{"[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
              " ", "\"\<_\>\"", ",", " ", 
              RowBox[{"lab", "[", 
               RowBox[{"[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], ",", " ", 
              RowBox[{"lab", "[", 
               RowBox[{"[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}], ",", "\n", 
              "         ", "\"\<  =  \>\"", ",", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "4", "]"}], "]"}]}], "\n", "       ", "}"}], 
            "]"}], " ", "&"}], " ", "/@", " ", "chrList"}], ")"}], ",", "\n", 
        "     ", 
        RowBox[{"Style", "[", 
