b733-191b58570fee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", " ", "=", " ", 
    RowBox[{
     RowBox[{"M", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"r", " ", ">", " ", 
      RowBox[{"2", " ", "M"}]}], " ", "&&", " ", 
     RowBox[{"0", " ", "<", " ", "th", " ", "<", " ", "Pi"}]}]}], ";"}], "\n",
   "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"M", " ", "=", " ", "1"}], ";"}], "\n", "\n"}], "\n", 
 RowBox[{
  RowBox[{"coords", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "r", ",", " ", "th", ",", " ", "ph"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"lab", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<t\>\"", ",", " ", "\"\<r\>\"", ",", " ", "\"\<th\>\"", ",", 
     " ", "\"\<ph\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dim", " ", "=", " ", 
    RowBox[{"Length", "[", "coords", "]"}]}], ";"}], "\n", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "r_", "]"}], " ", ":=", " ", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "M"}], ")"}], "/", "r"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", " ", "=", " ", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"f", "[", "r", "]"}]}], ",", " ", "0", ",", " ", "0", ",", 
        " ", "0"}], "}"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"1", "/", 
         RowBox[{"f", "[", "r", "]"}]}], ",", " ", "0", ",", " ", "0"}], 
       "}"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", 
        RowBox[{"r", "^", "2"}], ",", " ", "0"}], "}"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", 
        RowBox[{
         RowBox[{"r", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}]}], "}"}]}], "\n", 
     "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gInv", " ", "=", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Inverse", "[", "g", "]"}], "]"}]}], ";"}], "\n", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chrTab", " ", "=", " ", 
    RowBox[{"Simplify", "@", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"Sum", "[", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"gInv", "[", 
            RowBox[{"[", 
             RowBox[{"mu", ",", " ", "nu"}], "]"}], "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"g", "[", 
                RowBox[{"[", 
                 RowBox[{"nu", ",", " ", "be"}], "]"}], "]"}], ",", " ", 
               RowBox[{"coords", "[", 
                RowBox[{"[", "al", "]"}], "]"}]}], "]"}], " ", "+", " ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"g", "[", 
                RowBox[{"[", 
                 RowBox[{"nu", ",", " ", "al"}], "]"}], "]"}], ",", " ", 
               RowBox[{"coords", "[", 
                RowBox[{"[", "be", "]"}], "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"g", "[", 
                RowBox[{"[", 
                 RowBox[{"al", ",", " ", "be"}], "]"}], "]"}], ",", " ", 
               RowBox[{"coords", "[", 
