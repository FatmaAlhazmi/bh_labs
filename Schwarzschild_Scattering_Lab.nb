             RowBox[{"chr", "[", 
              RowBox[{"al", ",", " ", "mu", ",", " ", "al"}], "]"}], ",", " ", 
             RowBox[{"coords", "[", 
              RowBox[{"[", "nu", "]"}], "]"}]}], "]"}], " ", "+", "\n", 
           "       ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"chr", "[", 
                RowBox[{"al", ",", " ", "mu", ",", " ", "nu"}], "]"}], " ", 
