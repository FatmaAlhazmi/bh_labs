Cell["Metric components (diagonal form):", "Text",ExpressionUUID->"f54ea2c8-f71a-4654-a447-e2a2b43b1ad9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
