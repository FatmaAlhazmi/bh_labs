Cell[CellGroupData[{

Cell["5) Capture vs Escape experiment", "Section",
 FontSize->24,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.8, 0.4, 0.1],ExpressionUUID->"6d474f14-1793-400f-b904-7af314ec42e1"],

Cell["\<\
Equatorial scattering in the x-y plane. Choose energy E and impact parameter \
b.\
\>", "Text",ExpressionUUID->"2e34f00b-ac99-4c81-9881-76ced98d58bf"],

Cell["\<\
Equations used: rDot^2 = E^2 - V_eff(r),  b = L / Sqrt(E^2-1).  (timelike)\
\>", "Text",ExpressionUUID->"dcf1ea6a-57b4-46aa-ba43-98d371c0b726"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    FractionBox[
     RowBox[{"d", "r"}], 
     RowBox[{"d", "\[Tau]"}]], "2"], "=", 
   SuperscriptBox["E", "2"], "-", 
   RowBox[{
    RowBox[{"f", "(", "r", ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"\[Kappa]", "+", 
      FractionBox[
       SuperscriptBox["L", "2"], 
       SuperscriptBox["r", "2"]]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"a3527ccf-3150-4c91-\
a8be-1354c117c1fb"],

Cell[BoxData[
 FormBox[
  RowBox[{"b", "=", 
   FractionBox["L", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["E", "2"], "-", "1"}]]]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"9911a22e-164e-427c-\
ad9c-545ce194e2f7"],

Cell["\<\
Plot notes: black disk r=2M, dashed circle r=3M, blue point = max(V_eff) if \
it exists.\
\>", "Text",ExpressionUUID->"6d8c2b05-14d2-435f-9540-a6b7f66c6666"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "data", ",", " ", "xFar", ",", " ", "rFun", ",", " ", "phiFun", ",", 
       " ", "prFun", ",", " ", "tauEnd", ",", " ", "L", ",", " ", "status", ",",
        " ", "col", ",", "\n", "   ", "bh", ",", " ", "orbitPlot", ",", " ", 
       "potPlot", ",", " ", "rb", ",", " ", "vb", ",", " ", "msg", ",", " ", 
       "defl", ",", " ", "bcrit"}], "}"}], ",", "\n", "\n", "  ", 
     RowBox[{
      RowBox[{"data", " ", "=", " ", 
       RowBox[{"trajSolve", "[", 
        RowBox[{"en", ",", " ", "b"}], "]"}]}], ";", "\n", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"AssociationQ", "[", "data", "]"}]}], ",", "\n", "   ", 
        RowBox[{"Framed", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<No plot: run the setup cell first\>\"", ",", " ", 
            "14", ",", " ", "Red"}], "]"}], ",", " ", 
          RowBox[{"FrameMargins", " ", "->", " ", "20"}]}], "]"}], ",", "\n", 
        "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"data", "[", "\"\<ok\>\"", "]"}], "]"}]}], ",", "\n", 
          "   ", 
          RowBox[{"Framed", "[", "\n", "    ", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\<No plot: \>\"", " ", "<>", " ", 
               RowBox[{"ToString", "[", 
                RowBox[{"data", "[", "\"\<msg\>\"", "]"}], "]"}]}], ",", " ", 
              "14", ",", " ", "Red"}], "]"}], ",", "\n", "    ", 
            RowBox[{"FrameMargins", " ", "->", " ", "20"}]}], "\n", "    ", 
           "]"}], ",", "\n", "   ", 
          RowBox[{
           RowBox[{"xFar", " ", "=", " ", 
            RowBox[{"data", "[", "\"\<xFar\>\"", "]"}]}], ";", "\n", "   ", 
           RowBox[{"rFun", " ", "=", " ", 
            RowBox[{"data", "[", "\"\<r\>\"", "]"}]}], ";", "\n", "   ", 
           RowBox[{"phiFun", " ", "=", " ", 
            RowBox[{"data", "[", "\"\<phi\>\"", "]"}]}], ";", "\n", "   ", 
           RowBox[{"prFun", " ", "=", " ", 
