Cell[CellGroupData[{

Cell["9) Near-threshold scattering", "Section",
 FontSize->24,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.8, 0.4, 0.1],ExpressionUUID->"674c0d15-8f02-40a4-8586-faa6b853b9f5"],

Cell["\<\
Set b = b_max + delta b and scan capture vs escape close to the threshold.\
\>", "Text",ExpressionUUID->"842f947f-9dc1-4f3e-946c-9ffdadf196d8"],

Cell[BoxData[
 FormBox[
  RowBox[{"b", "=", 
   SubscriptBox["b", "max"], "+", "\[Delta]", "b"}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"91e87e36-c398-4c40-\
9c26-11a0f3eab678"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "b0", ",", " ", "bVal", ",", " ", "data", ",", " ", "xFar", ",", " ", 
       "rFun", ",", " ", "phiFun", ",", " ", "tauEnd", ",", " ", "L", ",", 
       " ", "status", ",", " ", "col", ",", " ", "bh", ",", " ", 
       "orbitPlot"}], "}"}], ",", "\n", "\n", "  ", 
     RowBox[{
      RowBox[{"b0", " ", "=", " ", 
       RowBox[{"bMax", "[", "en", "]"}]}], ";", "\n", "  ", 
      RowBox[{"bVal", " ", "=", " ", 
       RowBox[{"b0", " ", "+", " ", "db"}]}], ";", "\n", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"bVal", " ", "<=", " ", "0"}], ",", "\n", "   ", 
        RowBox[{"Framed", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<need b = bMax + db > 0\>\"", ",", " ", "14", ",", " ",
             "Red"}], "]"}], ",", " ", 
          RowBox[{"FrameMargins", " ", "->", " ", "20"}]}], "]"}], ",", "\n", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"data", " ", "=", " ", 
          RowBox[{"trajSolve", "[", 
           RowBox[{"en", ",", " ", "bVal"}], "]"}]}], ";", "\n", "\n", "   ", 
         
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"AssociationQ", "[", "data", "]"}]}], ",", "\n", "    ", 
           RowBox[{"Framed", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<No plot: run the setup cell first\>\"", ",", " ", 
               "14", ",", " ", "Red"}], "]"}], ",", " ", 
             RowBox[{"FrameMargins", " ", "->", " ", "20"}]}], "]"}], ",", 
           "\n", "\n", "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
