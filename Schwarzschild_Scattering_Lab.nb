   "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ricTab", " ", ":=", " ", 
    RowBox[{"ricTab", " ", "=", " ", 
     RowBox[{"Simplify", "@", 
      RowBox[{"Table", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Sum", "[", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"chr", "[", 
