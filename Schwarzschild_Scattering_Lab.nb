Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["\<\"Nonzero Christoffels (Schwarzschild)\"\>",
      StripOnInput->False,
      FontWeight->Bold], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"t\"", "\"_\"", "\"t\"", "\"r\"", "\"  =  \"", 
       FractionBox["1", 
        RowBox[{
          RowBox[{"(", 
            RowBox[{
              RowBox[{"-", "2"}], "+", "r"}], ")"}], " ", "r"}]]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"t\"", "\"_\"", "\"r\"", "\"t\"", "\"  =  \"", 
       FractionBox["1", 
        RowBox[{
          RowBox[{"(", 
            RowBox[{
              RowBox[{"-", "2"}], "+", "r"}], ")"}], " ", "r"}]]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"r\"", "\"_\"", "\"t\"", "\"t\"", "\"  =  \"", 
       FractionBox[
        RowBox[{
          RowBox[{"-", "2"}], "+", "r"}], 
        SuperscriptBox["r", "3"]]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"r\"", "\"_\"", "\"r\"", "\"r\"", "\"  =  \"", 
       FractionBox["1", 
        RowBox[{
          RowBox[{"2", " ", "r"}], "-", 
          SuperscriptBox["r", "2"]}]]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"r\"", "\"_\"", "\"th\"", "\"th\"", "\"  =  \"", 
       RowBox[{"2", "-", "r"}]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"r\"", "\"_\"", "\"ph\"", "\"ph\"", "\"  =  \"", 
       RowBox[{"-", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 RowBox[{"-", "2"}], "+", "r"}], ")"}], " ", 
             SuperscriptBox[
              RowBox[{"Sin", "[", "th", "]"}], "2"]}], ")"}]}]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"th\"", "\"_\"", "\"r\"", "\"th\"", "\"  =  \"", 
       FractionBox["1", "r"]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"th\"", "\"_\"", "\"th\"", "\"r\"", "\"  =  \"", 
       FractionBox["1", "r"]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"th\"", "\"_\"", "\"ph\"", "\"ph\"", "\"  =  \"", 
       RowBox[{
         RowBox[{"-", 
           RowBox[{"Cos", "[", "th", "]"}]}], " ", 
         RowBox[{"Sin", "[", "th", "]"}]}]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"ph\"", "\"_\"", "\"r\"", "\"ph\"", "\"  =  \"", 
       FractionBox["1", "r"]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"ph\"", "\"_\"", "\"th\"", "\"ph\"", "\"  =  \"", 
       RowBox[{"Cot", "[", "th", "]"}]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"ph\"", "\"_\"", "\"ph\"", "\"r\"", "\"  =  \"", 
       FractionBox["1", "r"]},
      "RowDefault"], ",", 
     TemplateBox[{
      "\"Gamma^\"", "\"ph\"", "\"_\"", "\"ph\"", "\"th\"", "\"  =  \"", 
       RowBox[{"Cot", "[", "th", "]"}]},
      "RowDefault"]}], "}"}], ",", 
   RowBox[{"Alignment", "\[Rule]", "Left"}], ",", 
   RowBox[{"Spacings", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0.6`"}], "}"}]}]}], "]"}]], "Output",
 CellChangeTimes->{3.9750050870165586`*^9},
 CellLabel->
