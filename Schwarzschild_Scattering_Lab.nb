       Hold[$CellContext`en$$], 2.77, "en"}, 1.01, 5, 0.01, ControlType -> 
      Manipulator}, {{
       Hold[$CellContext`d$$], 0.2, "offset d"}, 0, 3, 0.01, ControlType -> 
      Manipulator}}, Typeset`size$$ = {
    335.24953124999996`, {169.4644194878472, 175.1963530815972}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`d$$ = 0.2, $CellContext`en$$ = 2.77}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`b0$, $CellContext`bs$, $CellContext`sols$, \
$CellContext`cols$, $CellContext`labels$, $CellContext`xFar$, \
$CellContext`bh$, $CellContext`plots$, $CellContext`legendG$}, \
$CellContext`b0$ = $CellContext`bMax[$CellContext`en$$]; $CellContext`bs$ = \
{$CellContext`b0$ - $CellContext`d$$, $CellContext`b0$, $CellContext`b0$ + \
$CellContext`d$$}; $CellContext`cols$ = {
          Red, Black, Blue}; $CellContext`labels$ = {
          "b<bMax", "b=bMax", "b>bMax"}; $CellContext`sols$ = 
         Map[$CellContext`trajSolve[$CellContext`en$$, #, 30., 
            2500.]& , $CellContext`bs$]; If[
          Not[
           AssociationQ[
            Part[$CellContext`sols$, 1]]], 
          Framed[
           Style["No plot: run the setup cell first", 14, Red], FrameMargins -> 
           20], $CellContext`xFar$ = 30.; $CellContext`bh$ = 
           Graphics[{Black, 
              Disk[{0, 0}, 2 $CellContext`M], Gray, Dashed, 
              Circle[{0, 0}, 3 $CellContext`M]}]; $CellContext`plots$ = 
           Table[
             If[
              TrueQ[
               Part[$CellContext`sols$, $CellContext`i]["ok"]], 
              
              With[{$CellContext`rFun$ = 
                Part[$CellContext`sols$, $CellContext`i][
                 "r"], $CellContext`phiFun$ = 
                Part[$CellContext`sols$, $CellContext`i][
                 "phi"], $CellContext`tauEnd$ = 
                Part[$CellContext`sols$, $CellContext`i]["tauEnd"]}, 
               ParametricPlot[
                Evaluate[{$CellContext`rFun$[$CellContext`t] Cos[
                    $CellContext`phiFun$[$CellContext`t]], \
$CellContext`rFun$[$CellContext`t] Sin[
                    $CellContext`phiFun$[$CellContext`t]]}], {$CellContext`t, 
                 0, $CellContext`tauEnd$}, PlotStyle -> 
                Part[$CellContext`cols$, $CellContext`i]]], 
              Graphics[{}]], {$CellContext`i, 1, 3}]; $CellContext`legendG$ = 
           Graphics[{
              Text[
               Style[
                Part[$CellContext`labels$, 1], 12, 
                Part[$CellContext`cols$, 1]], 
               Scaled[{0.82, 0.92}]], 
              Text[
               Style[
                Part[$CellContext`labels$, 2], 12, 
                Part[$CellContext`cols$, 2]], 
               Scaled[{0.82, 0.87}]], 
              Text[
               Style[
                Part[$CellContext`labels$, 3], 12, 
                Part[$CellContext`cols$, 3]], 
               Scaled[{0.82, 0.82}]]}]; Show[$CellContext`bh$, 
            Evaluate[
             Apply[Sequence, $CellContext`plots$]], $CellContext`legendG$, 
            PlotRange -> {{-$CellContext`xFar$, $CellContext`xFar$}, \
{-$CellContext`xFar$, $CellContext`xFar$}}, Frame -> True, AspectRatio -> 1, 
            FrameLabel -> {"x", "y"}, PlotLabel -> Style[
              Row[{"3 trajectories near bMax   (en = ", 
                NumberForm[$CellContext`en$$, {5, 3}], ")"}], 14, Bold]]]], 
      "Specifications" :> {{{$CellContext`en$$, 2.77, "en"}, 1.01, 5, 0.01, 
