Cell[CellGroupData[{

Cell["3) Christoffel symbols (Gamma)", "Section",
 FontSize->24,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.8, 0.4, 0.1],ExpressionUUID->"22937f42-3104-44c2-a218-bbeae3b0b34a"],

Cell["\<\
Compute the connection coefficients Gamma^mu_{alpha beta} from the metric.\
\>", "Text",ExpressionUUID->"49a4d9a8-1c1a-40e1-97c9-d26362c711b1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["Gamma", 
    RowBox[{"\[Alpha]", "\[Beta]"}], "\[Mu]"], "=", 
   FractionBox["1", "2"], " ", 
   SuperscriptBox["g", 
    RowBox[{"\[Mu]", "\[Nu]"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Alpha]"], 
      SubscriptBox["g", 
       RowBox[{"\[Nu]", "\[Beta]"}]]}], "+", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Beta]"], 
      SubscriptBox["g", 
       RowBox[{"\[Nu]", "\[Alpha]"}]]}], "-", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Nu]"], 
      SubscriptBox["g", 
       RowBox[{"\[Alpha]", "\[Beta]"}]]}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"c5bec01c-b1ae-43d3-\
a350-227124b3ce1d"],

