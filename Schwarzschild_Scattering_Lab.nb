                  " ", 
                 RowBox[{
                  RowBox[{"cap", " ", "=", " ", "True"}], ";", 
                  " ", "\"\<StopIntegration\>\""}]}], "]"}], ",", "\n", 
               "        ", 
               RowBox[{"WhenEvent", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"r", "[", "tau", "]"}], " ", ">=", " ", "200"}], ",",
                  " ", 
                 RowBox[{
                  RowBox[{"esc", " ", "=", " ", "True"}], ";", 
                  " ", "\"\<StopIntegration\>\""}]}], "]"}]}], "\n", 
              "       ", "}"}], ",", "\n", "       ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "phi", ",", " ", "pr"}], "}"}], ",", 
             "\n", "       ", 
             RowBox[{"{", 
              RowBox[{"tau", ",", " ", "0", ",", " ", "tauMax"}], "}"}], ",", 
             "\n", "       ", 
             RowBox[{"MaxSteps", " ", "->", " ", "Infinity"}], ",", "\n", 
             "       ", 
             RowBox[{"Method", " ", "->", " ", 
              RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}]}], "\n", 
            "     ", "]"}], ",", "\n", "     ", "$Failed"}], "\n", "   ", 
          "]"}]}]}], ";", "\n", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sol", " ", "===", " ", "$Failed"}], ",", " ", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<ok\>\"", " ", "->", " ", "False"}], ",", " ", 
            
            RowBox[{"\"\<msg\>\"", " ", "->", 
             " ", "\"\<NDSolve failed\>\""}]}], "|>"}], "]"}]}], "]"}], ";", 
       "\n", "\n", "  ", 
       RowBox[{"rFun", " ", "=", " ", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"phiFun", " ", "=", " ", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"prFun", " ", "=", " ", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"tauEnd", " ", "=", " ", 
        RowBox[{
         RowBox[{"rFun", "[", "\"\<Domain\>\"", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", "\n", "  ", 
       RowBox[{"en2", " ", "=", " ", 
        RowBox[{
         RowBox[{"eps", "^", "2"}], " ", "+", " ", 
         RowBox[{"Veff", "[", 
          RowBox[{"r0", ",", " ", "L0"}], "]"}]}]}], ";", "\n", "\n", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<ok\>\"", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"\"\<r\>\"", " ", "->", " ", "rFun"}], ",", " ", 
         RowBox[{"\"\<phi\>\"", " ", "->", " ", "phiFun"}], ",", " ", 
         RowBox[{"\"\<pr\>\"", " ", "->", " ", "prFun"}], ",", " ", 
         RowBox[{"\"\<tauEnd\>\"", " ", "->", " ", "tauEnd"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<L\>\"", " ", "->", " ", "L0"}], ",", " ", 
         RowBox[{"\"\<en2\>\"", " ", "->", " ", "en2"}], ",", " ", 
         RowBox[{"\"\<captured\>\"", " ", "->", " ", "cap"}], ",", " ", 
         RowBox[{"\"\<escaped\>\"", " ", "->", " ", "esc"}]}], "|>"}]}]}], 
     "\n", "]"}]}], ";"}], "\n", "\n", "\n", "\n", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rCrit", "[", "en_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"en", "^", "2"}]}], " ", "-", " ", "4", " ", "+", " ", 
       RowBox[{"en", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"9", " ", 
           RowBox[{"en", "^", "2"}]}], " ", "-", " ", "8"}], "]"}]}]}], ")"}],
      "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"en", "^", "2"}], " ", "-", " ", "1"}], ")"}]}], ")"}]}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bMax", "[", "en_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rc", " ", "=", " ", 
        RowBox[{"rCrit", "[", "en", "]"}]}], "}"}], ",", " ", 
      RowBox[{"rc", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"en", "^", "2"}], " ", "-", " ", "1"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"rc", " ", "-", " ", "3"}], ")"}]}], "]"}]}]}], " ", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sigma", "[", "en_", "]"}], " ", ":=", " ", 
    RowBox[{"Pi", " ", 
     RowBox[{
      RowBox[{"bMax", "[", "en", "]"}], "^", "2"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"bPhoton", " ", ":=", " ", 
   RowBox[{"3", " ", 
    RowBox[{"Sqrt", "[", "3", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigmaMax", " ", ":=", " ", 
   RowBox[{"27", " ", "Pi"}]}], ";"}]}], "Input",
 CellFrame->{{1, 1}, {1, 1}},
